# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# SMS proxy (production) — supabase/functions/send-sms
# در UI: studioInfo.smsProxyUrl = https://YOUR_PROJECT.supabase.co/functions/v1/send-sms
VITE_SMS_PROXY_URL=https://YOUR_PROJECT.supabase.co/functions/v1/send-sms

# Edge Function secrets (set via: supabase secrets set ...)
# ملی پیامک (کنسول — توکن UUID):
# SMS_PROVIDER=melipayamak
# SMS_API_KEY=your-console-api-token
# SMS_LINE_NUMBER=5000...
#
# یا وب‌سرویس کلاسیک:
# SMS_USERNAME=your-panel-username
# SMS_API_KEY=your-webservice-password
# SMS_LINE_NUMBER=5000...
# یا: SMS_API_KEY=username:password
#
# کاوه‌نگار / سایر:
# SMS_PROVIDER=kavenegar
# SMS_API_KEY=your-sms-api-key
# SMS_LINE_NUMBER=your-line-number

# یا از تنظیمات اپ: Studio M Pro → تنظیمات → ابر Supabase
