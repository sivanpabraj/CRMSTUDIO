# ══════════════════════════════════════════════════════════════
# CRMSTUDIO — پیکربندی جامع متغیرهای محیطی محیط تولید (Production Env)
# ══════════════════════════════════════════════════════════════

# ─── ۱. سرور همگام‌سازی و هسته سیستم (Sync Server & Core) ──────────
PORT=3000
DATA_DIR=/var/lib/crmstudio
# کلید امنیتی برای بازنشانی و به‌روزرسانی سیستمی (حداقل ۱۲ کاراکتر پیچیده الزامی است)
SYSTEM_UPDATE_KEY=your_secure_master_key_min_12_chars_random_string

# ─── ۲. درگاه پیامک (SMS Gateway — MeliPayamak / Kavenegar) ────
# ملی پیامک (کنسول توکن وب‌سرویس):
MELIPAYAMAK_API_KEY=your_melipayamak_api_token
MELIPAYAMAK_LINE=5000...

# کاوه‌نگار (در صورت استفاده):
KAVENEGAR_API_KEY=your_kavenegar_api_key

# ─── ۳. اعلان‌های ایمیلی (SMTP Mail Server) ──────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=studio.mandani@gmail.com
SMTP_PASS=your_app_specific_password

# ─── ۴. بات‌های پیام‌رسان بله و تلگرام (Bale & Telegram Bots) ─────
# ربات بله (جهت دریافت لاگ‌ها، اعلان‌های فوری آفیش و بکاپ):
BALE_BOT_TOKEN=your_bale_bot_token
BALE_BOT_USERNAME=CRMStudioBot
BALE_CHAT_ID=your_bale_chat_or_channel_id

# ربات تلگرام:
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_channel_or_chat_id

# ─── ۵. سرور SaaS چندمستأجره (اختیاری — Multi-Tenant PostgreSQL) ──
# DATABASE_URL=postgresql://crmstudio:your_secure_pass@127.0.0.1:5432/crmstudio
# JWT_SECRET=your_jwt_secret_must_be_at_least_32_characters_long
# ALLOWED_ORIGIN=https://crm.studiomandani.ir

# ─── ۶. ارتباطات فرانت‌اند و پروکسی Supabase Edge Functions ──────
# VITE_SMS_PROXY_URL=https://YOUR_PROJECT.supabase.co/functions/v1/send-sms
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
