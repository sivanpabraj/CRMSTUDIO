{
  "name": "studio-erp",
  "version": "6.3.0",
  "description": "پلتفرم جامع مدیریت سازمانی استودیو (Studio ERP)",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/sync-server.mjs",
    "server:sync": "node server/sync-server.mjs",
    "server:saas": "node server/saas-server.mjs",
    "dev": "vite",
    "build": "vite build && node scripts/copy-static.mjs",
    "preview": "vite preview",
    "lint": "eslint js/ studio-m/js/ admin.js contract.js eslint.config.js eslint.globals.js --max-warnings 0 --no-warn-ignored",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.52.0",
    "eslint": "^10.6.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.1"
  }
}
